{
  "name": "@kubri/mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5186 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4186 --strictPort",
    "test": "node --experimental-strip-types tests/mobile-contracts.test.ts && node --experimental-strip-types tests/operational-workflows.test.ts && node --experimental-strip-types tests/purchase-safety.test.ts",
    "typecheck": "tsc -b --pretty false",
    "cap:sync": "npm run build && cap sync",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "3.1.0",
    "@capacitor/core": "8.4.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/cli": "8.4.2",
    "@capacitor/ios": "8.4.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "^5.5.3",
    "vite": "8.1.5"
  }
}
