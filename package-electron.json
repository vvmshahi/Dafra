{
  "name": "meem",
  "version": "1.0.0",
  "description": "Meem POS — ZATCA Compliant Invoicing",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.meem.pos",
    "productName": "Meem",
    "copyright": "Copyright 2026 Meem",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Meem POS"
    },
    "publish": {
      "provider": "github",
      "owner": "vvmshahi",
      "repo": "Dafra"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
