# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── App URL ───────────────────────────────────────────────────────────────────
# Used for auth email redirect URLs (password reset, email confirmation)
# Development: http://localhost:5173
# Production:  https://dafra.vercel.app
VITE_APP_URL=https://dafra.vercel.app

# ── ZATCA ─────────────────────────────────────────────────────────────────────
# Master secret used to AES-256-GCM encrypt branch private keys before storing in DB.
# Browser uses VITE_ZATCA_KEY_SECRET; edge function uses ZATCA_KEY_SECRET (no prefix).
# Both must be set to the SAME value. Set ZATCA_KEY_SECRET in Supabase Edge Function secrets.
# Generate with: openssl rand -base64 32
VITE_ZATCA_KEY_SECRET=your-32-char-secret-here
