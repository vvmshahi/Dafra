# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── App URL ───────────────────────────────────────────────────────────────────
# Used for auth email redirect URLs (password reset, email confirmation)
# Development: http://localhost:5173
# Production:  https://dafra.vercel.app
VITE_APP_URL=https://dafra.vercel.app

# ── ZATCA production onboarding ───────────────────────────────────────────────
# Backend-only Supabase Edge Function secrets. Set these in Supabase, not in
# frontend/browser env files, and never prefix them with VITE_.
#
# ZATCA_SERVER_ENCRYPTION_KEY=generate-a-long-random-secret
# ZATCA_PRODUCTION_BASE_URL=https://gw-fatoora.zatca.gov.sa/e-invoicing/core
# ALLOW_ZATCA_PRODUCTION_ONBOARDING=false
#
# Do not use VITE_ variables for private keys, CSIDs, OTPs, ZATCA secrets,
# production certificates, or encryption keys.
