{
  "name": "kubri",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k -n vite,electron -c green,blue \"vite --host 127.0.0.1 --port 5175 --strictPort\" \"wait-on http://127.0.0.1:5175 && node electron/run.cjs\"",
    "desktop:preview": "npm run build && node electron/run.cjs --preview",
    "desktop:build": "npm run build && electron-builder --win nsis --x64",
    "desktop:build:win": "npm run build && electron-builder --win nsis --x64",
    "desktop:build:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "desktop:build:all": "npm run build && electron-builder --win nsis --x64 --mac dmg zip --x64 --arm64",
    "zatca:validate-sample": "node scripts/validate-zatca-compliance-sample.mjs",
    "zatca:export-real-invoice": "node scripts/export-zatca-real-invoice-xml.mjs",
    "zatca:validate-real-invoice": "node scripts/export-zatca-real-invoice-xml.mjs --validate",
    "audit:f3-identity": "node scripts/audit-f3-identity-separation.mjs",
    "audit:f3a-migration": "node scripts/audit-f3a-migration.mjs",
    "audit:f3b-profile": "node scripts/audit-f3b-profile-workflow.mjs",
    "audit:phase1-official-seller": "node scripts/audit-phase1-official-seller-ui.mjs",
    "audit:phase2-seller-flow": "node scripts/audit-phase2-simplified-seller-flow.mjs",
    "audit:phase3b-local-baseline": "node scripts/audit-phase3b-local-baseline.mjs",
    "test:phase3c-official-seller": "node scripts/test-phase3c-official-seller-runtime.mjs",
    "test:phase3d-invoice-snapshot": "node scripts/test-phase3d-invoice-snapshot-runtime.mjs",
    "audit:phase4b-invoice-settings": "node scripts/audit-phase4b-invoice-settings.mjs",
    "test:phase4b-invoice-settings": "node scripts/test-phase4b-invoice-settings-runtime.mjs",
    "audit:phase4c-invoice-settings-ui": "node scripts/audit-phase4c-invoice-settings-ui.mjs",
    "test:phase4d-document-view-model": "node scripts/test-phase4d-document-view-model.mjs",
    "audit:phase4d-document-view-model": "node scripts/audit-phase4d-document-view-model.mjs"
  },
  "build": {
    "appId": "com.kubri.pos",
    "productName": "Kubri",
    "copyright": "Copyright 2026 Kubri",
    "directories": {
      "output": "dist-electron",
      "buildResources": "electron/assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico",
      "artifactName": "Kubri-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/assets/icon.icns",
      "artifactName": "Kubri-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kubri"
    }
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/qrcode": "^1.5.6",
    "emoji-picker-react": "^4.19.1",
    "i18next": "^26.3.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "wait-on": "^8.0.5"
  }
}
